<Window x:Class="SiegeCrashScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Siege Crash Scanner" Width="1180" Height="820" MinWidth="850" MinHeight="620"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0E1219" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="34,22">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SIEGE CRASH SCANNER" FontSize="23" FontWeight="Bold"/>
                    <TextBlock Text="Local, read-only crash diagnostics for Rainbow Six Siege" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="20" Background="#183627" Padding="13,7" VerticalAlignment="Center">
                    <TextBlock Text="WINDOWS 11 · X64" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12"/>
                </Border>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Background="{StaticResource WindowBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="34,28,34,50">
                <Border x:Name="AppUpdatePanel" Visibility="Collapsed" Background="#16261E" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="9" Margin="0,0,10,20" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="Siege Crash Scanner update available" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AppUpdateStatusText" Text="A newer verified release is ready." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button x:Name="InstallAppUpdateButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="INSTALL UPDATE" Click="InstallAppUpdateButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Your PC" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SystemStatusText" Text="Reading Windows system information…" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="No files or settings are changed by a scan" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding SystemItems}" Margin="0,18,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,0,10,10" Padding="16,14">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Content="SCAN MY PC" FontSize="18" Padding="28,18"
                        HorizontalAlignment="Stretch" Margin="0,14,0,0" Click="ScanButton_Click"/>
                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,18,10,0" Padding="18">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Text="GPU &amp; platform driver updates" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Installs applicable signed Intel/AMD platform and NVIDIA/AMD/Intel display drivers offered for this PC by Windows Update. BIOS firmware is never changed."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button x:Name="DriverUpdateButton" Grid.Column="1" Content="UPDATE DRIVERS" Click="DriverUpdateButton_Click" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <Border x:Name="DriverOutputPanel" Visibility="Collapsed" Background="#080A0E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,10,10,0" Padding="14">
                    <TextBox x:Name="DriverOutput" Text="" Background="Transparent" Foreground="#CAD3DF" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" MinHeight="100" MaxHeight="300" VerticalScrollBarVisibility="Auto"/>
                </Border>
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,15,0,0">
                    <ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" Background="{StaticResource PanelAltBrush}"/>
                    <TextBlock x:Name="ProgressText" Text="Scanning…" Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Margin="0,36,0,0">
                    <TextBlock Text="Siege Crash Scan Results" FontSize="26" FontWeight="Bold"/>
                    <TextBlock x:Name="ResultsSubtitle" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,20"/>
                    <ItemsControl ItemsSource="{Binding FindingItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,0,0,10" Padding="18,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="7"/><ColumnDefinition Width="18"/><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Background="{Binding Color}" CornerRadius="4"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,12,0,0" Padding="18">
                        <Expander Header="Siege crash event details" IsExpanded="True">
                            <ItemsControl ItemsSource="{Binding CrashItems}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="14" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding Time}" FontWeight="SemiBold"/><TextBlock Text="{Binding Application}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                                <StackPanel Grid.Column="1"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/><TextBlock Text="{Binding Explanation}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,12,0,0" Padding="18">
                        <Expander Header="WHEA and graphics-driver event details">
                            <ItemsControl ItemsSource="{Binding EventItems}" Margin="0,14,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource PanelAltBrush}" CornerRadius="7" Padding="14" Margin="0,0,0,8">
                                            <StackPanel><TextBlock Text="{Binding Heading}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </Border>
                    <Border Background="#101D18" BorderBrush="#28583F" BorderThickness="1" CornerRadius="9" Margin="0,18,0,0" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Most likely causes" FontSize="19" FontWeight="SemiBold"/>
                            <ItemsControl ItemsSource="{Binding CauseItems}" Margin="0,12,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Rank}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <StackPanel Grid.Column="2"><TextBlock Text="{Binding Likelihood}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/><TextBlock Text="{Binding Evidence}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/></StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="9" Margin="0,12,0,0" Padding="20">
                        <StackPanel><TextBlock Text="Recommended Next Step" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold"/><TextBlock x:Name="RecommendationText" FontSize="17" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                    </Border>
                    <TextBlock Text="Windows integrity tools" FontSize="20" FontWeight="SemiBold" Margin="0,30,0,5"/>
                    <TextBlock Text="These official Windows repairs require administrator approval and run only when you click them." Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="SfcButton" Content="Run SFC Scan" Click="SfcButton_Click" Margin="0,0,10,0"/>
                        <Button x:Name="DismButton" Content="Run DISM Repair" Click="DismButton_Click"/>
                    </StackPanel>
                    <Border Background="#080A0E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,12,0,0" Padding="14">
                        <TextBox x:Name="CommandOutput" Text="Command output will appear here." Background="Transparent" Foreground="#CAD3DF" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                 TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" MinHeight="120" MaxHeight="350" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                    <Button x:Name="ExportButton" Content="Export Diagnostic Report" Click="ExportButton_Click" HorizontalAlignment="Left" Margin="0,24,0,0"/>
                    <TextBlock Text="The exported report removes usernames, computer names, IP addresses, and does not collect serial numbers." Foreground="{StaticResource MutedBrush}" Margin="0,9,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
